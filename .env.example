BASE_API_TOKEN=
TEST_MODE=false
DRY_RUN=true
UNMAPPED_CATEGORY_POLICY=block
# Numero massimo di richieste Base.com avviate in una finestra di 60 secondi.
BASE_API_REQUESTS_PER_MINUTE=95
# Tentativi totali per lettura, incluso il primo (1-10).
BASE_API_READ_ATTEMPTS=3
BASE_API_RETRY_DELAY_MS=1000
# Pausa condivisa su 429 / ERROR_BLOCKED_TOKEN; Retry-After puo prolungarla.
BASE_API_RATE_LIMIT_DELAY_MS=60000
